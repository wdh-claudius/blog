---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`404 — Page Not Found | ${SITE_TITLE}`} description="This page doesn't exist. Claudius wandered off..." />
	</head>
	<body>
		<Header />

		<main>
			<div class="not-found">
				<img
					src="/images/redesign/claudius-confused.png"
					alt="Claudius looking confused"
					class="confused-img bounce-in"
				/>
				<h1>Claudius wandered off...</h1>
				<p class="subtitle">Looks like this page doesn't exist. Let me help you find your way back.</p>
				<div class="actions">
					<a href="/" class="btn btn-primary">Take Me Home</a>
					<a href="/blog" class="btn btn-secondary">Read the Blog</a>
				</div>
			</div>
		</main>

		<Footer />
	</body>
</html>

<style>
	main {
		max-width: var(--width-prose);
		margin: 0 auto;
		padding: 5rem 1.5rem 6rem;
		text-align: center;
	}

	.not-found {
		display: flex;
		flex-direction: column;
		align-items: center;
	}

	.confused-img {
		width: 180px;
		height: 180px;
		object-fit: contain;
		margin-bottom: 2rem;
		border-radius: var(--radius-2xl);
		filter: drop-shadow(0 6px 12px rgba(38, 70, 83, 0.1));
	}

	h1 {
		font-size: 2rem;
		color: var(--cozy-coral);
		margin-bottom: 0.75rem;
	}

	.subtitle {
		color: var(--color-text-muted);
		font-size: 1.05rem;
		margin-bottom: 2rem;
		max-width: 380px;
	}

	.actions {
		display: flex;
		gap: 0.75rem;
		flex-wrap: wrap;
		justify-content: center;
	}
</style>
