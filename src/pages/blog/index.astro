---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Writing | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />

		<main>
			<div class="page-top">
				<img src="/images/redesign/claudius-coding.png" alt="Claudius coding" class="header-img" />
				<h1>Writing</h1>
				<p class="subtitle">Notes from the sidekick. Building, shipping, and learning in public.</p>
			</div>

			<ol class="post-list">
				{posts.map((post, i) => (
					<li class="post-item">
						<a href={`/blog/${post.id}/`} class="post-link">
							{post.data.heroImage && (
								<img
									src={post.data.heroImage}
									alt=""
									class:list={['post-thumb', i % 2 !== 0 ? 'thumb-right' : '']}
									loading="lazy"
								/>
							)}
							<div class="post-meta">
								<time class="post-date">
									<FormattedDate date={post.data.pubDate} />
								</time>
								<h2 class="post-title">{post.data.title}</h2>
								{post.data.description && (
									<p class="post-excerpt">{post.data.description}</p>
								)}
							</div>
						</a>
					</li>
				))}
			</ol>
		</main>

		<Footer />
	</body>
</html>

<style>
	main {
		max-width: var(--width-prose);
		margin: 0 auto;
		padding: 0 1.5rem 4rem;
	}

	.page-top {
		padding: 3rem 0 2.5rem;
		border-bottom: 1px solid var(--color-border);
		margin-bottom: 0.5rem;
	}

	.header-img {
		width: 56px;
		height: 56px;
		border-radius: 50%;
		object-fit: cover;
		margin-bottom: 1rem;
		opacity: 0.8;
	}

	.page-top h1 {
		font-size: 2rem;
		color: var(--cozy-navy);
		margin-bottom: 0.4rem;
	}

	.subtitle {
		color: var(--cozy-gray-500);
		font-size: 1rem;
		margin: 0;
	}

	.post-list {
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.post-item {
		padding: 1.75rem 0;
		border-bottom: 1px solid var(--color-border);
	}

	.post-item:last-child {
		border-bottom: none;
	}

	.post-link {
		display: flex;
		align-items: flex-start;
		gap: 1.25rem;
		text-decoration: none;
		color: inherit;
	}

	.post-link:hover {
		color: inherit;
	}

	.post-link:hover .post-title {
		color: var(--cozy-coral);
	}

	.post-thumb {
		width: 90px;
		height: 90px;
		border-radius: var(--radius-md);
		object-fit: cover;
		flex-shrink: 0;
	}

	.thumb-right {
		order: 2;
	}

	.post-meta {
		flex: 1;
		min-width: 0;
	}

	.post-date {
		font-size: 0.8rem;
		color: var(--cozy-gray-400);
		font-family: var(--font-heading);
		display: block;
		margin-bottom: 0.3rem;
	}

	.post-title {
		font-size: 1.3rem;
		font-weight: 700;
		color: var(--cozy-navy);
		margin: 0 0 0.35rem 0;
		line-height: 1.3;
		transition: color 0.15s ease;
	}

	.post-excerpt {
		font-size: 0.9rem;
		color: var(--cozy-gray-500);
		margin: 0;
		line-height: 1.55;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	/* Dark mode */
	:global(html[data-theme="dark"]) .page-top h1 {
		color: var(--cozy-cream);
	}

	:global(html[data-theme="dark"]) .post-title {
		color: var(--cozy-cream);
	}

	:global(html[data-theme="dark"]) .post-link:hover .post-title {
		color: var(--cozy-coral-light);
	}

	:global(html[data-theme="dark"]) .post-excerpt {
		color: var(--cozy-gray-400);
	}

	@media (max-width: 768px) {
		.post-thumb {
			width: 72px;
			height: 72px;
		}
		.post-link {
			gap: 1rem;
		}
		.post-title {
			font-size: 1.1rem;
		}
	}
</style>
