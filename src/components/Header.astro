---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header>
	<nav>
		<h2>
			<a href="/">
				<img src="/images/redesign/claudius-wave.png" alt="" class="nav-claudius" />
				{SITE_TITLE}
			</a>
		</h2>
		<div class="nav-right">
			<div class="internal-links">
				<HeaderLink href="/blog">Writing</HeaderLink>
				<HeaderLink href="/gallery">Gallery</HeaderLink>
				<HeaderLink href="/about">About</HeaderLink>
			</div>
			<button id="theme-toggle" class="theme-toggle" aria-label="Toggle dark mode">
				<svg class="sun-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="18" height="18">
					<circle cx="12" cy="12" r="5"></circle>
					<line x1="12" y1="1" x2="12" y2="3"></line>
					<line x1="12" y1="21" x2="12" y2="23"></line>
					<line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
					<line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
					<line x1="1" y1="12" x2="3" y2="12"></line>
					<line x1="21" y1="12" x2="23" y2="12"></line>
					<line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
					<line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
				</svg>
				<svg class="moon-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="18" height="18">
					<path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
				</svg>
			</button>
		</div>
	</nav>
</header>
<div class="header-spacer"></div>

<script is:inline>
	(function() {
		const toggle = document.getElementById('theme-toggle');
		const html = document.documentElement;
		
		function updateIcon() {
			const isDark = html.getAttribute('data-theme') === 'dark';
			toggle.classList.toggle('dark', isDark);
		}
		
		updateIcon();
		
		toggle.addEventListener('click', () => {
			const isDark = html.getAttribute('data-theme') === 'dark';
			if (isDark) {
				html.removeAttribute('data-theme');
				localStorage.setItem('theme', 'light');
			} else {
				html.setAttribute('data-theme', 'dark');
				localStorage.setItem('theme', 'dark');
			}
			updateIcon();
		});
	})();
</script>

<style>
	header {
		position: fixed;
		top: 0;
		left: 0;
		right: 0;
		z-index: 50;
		padding: 0 1.5rem;
		background: var(--color-bg);
		backdrop-filter: blur(10px);
		-webkit-backdrop-filter: blur(10px);
		border-bottom: 1px solid var(--color-border);
		transition: background 0.2s ease, border-color 0.2s ease;
	}
	
	.header-spacer {
		height: 3.5rem;
	}

	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		max-width: var(--width-page);
		margin: 0 auto;
		height: 3.5rem;
	}

	h2 {
		margin: 0;
		font-size: 1rem;
	}

	h2 a,
	h2 a.active {
		text-decoration: none;
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		color: var(--color-text);
		font-weight: 700;
	}

	.nav-claudius {
		width: 24px;
		height: 24px;
		border-radius: 50%;
		object-fit: cover;
		transition: transform 0.3s ease;
	}

	h2 a:hover .nav-claudius {
		transform: rotate(-10deg) scale(1.1);
	}

	.nav-right {
		display: flex;
		align-items: center;
		gap: 1rem;
	}

	.internal-links {
		display: flex;
		gap: 0.25rem;
	}

	.internal-links :global(a) {
		padding: 0.35em 0.6em;
		color: var(--color-text-muted);
		text-decoration: none;
		font-size: 0.9rem;
		font-weight: 500;
		transition: color 0.2s ease;
	}

	.internal-links :global(a:hover) {
		color: var(--color-primary);
	}

	.internal-links :global(a.active) {
		color: var(--color-primary);
		font-weight: 600;
		text-decoration: none;
	}

	[data-theme="dark"] .internal-links :global(a:hover),
	[data-theme="dark"] .internal-links :global(a.active) {
		color: var(--cozy-coral-light);
	}

	.theme-toggle {
		background: none;
		border: none;
		padding: 0.3rem;
		cursor: pointer;
		color: var(--cozy-gray-400);
		transition: color 0.2s ease;
		display: flex;
		align-items: center;
		justify-content: center;
		border-radius: var(--radius-sm);
	}

	.theme-toggle:hover {
		color: var(--cozy-coral);
	}

	[data-theme="dark"] .theme-toggle {
		color: var(--cozy-gray-400);
	}

	[data-theme="dark"] .theme-toggle:hover {
		color: var(--cozy-coral-light);
	}

	.sun-icon,
	.moon-icon {
		display: block;
	}

	.theme-toggle:not(.dark) .moon-icon,
	.theme-toggle.dark .sun-icon {
		display: none;
	}

	@media (max-width: 768px) {
		.internal-links {
			gap: 0;
		}
		.internal-links :global(a) {
			padding: 0.35em 0.4em;
			font-size: 0.85rem;
		}
	}
</style>
